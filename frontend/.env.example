# Copy to .env for local testing. On Railway (or wherever you deploy),
# set these in the platform's environment/variables UI instead.

# Password for the login page. No functional default is baked into the
# code on purpose -- set your own here.
APP_PASSWORD=changeme

# Required. Your n8n chat webhook's public URL (Chat Trigger node, with
# "Make Chat Publicly Available" on). Get this from your own n8n instance.
N8N_CHAT_WEBHOOK_URL=https://your-n8n-instance.example.com/webhook/your-webhook-id/chat

# Optional: Flask session signing key. Auto-generated if unset.
# FLASK_SECRET_KEY=
