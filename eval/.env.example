# Copy this file to .env and fill in your own values.
# .env is never sent anywhere by this project except read locally by Docker.

# Required: RAGAS uses this as the LLM judge (Faithfulness, Answer Relevancy,
# Context Precision, Context Recall) and for embeddings. Set your own key --
# this project never asks you to paste it anywhere else.
OPENAI_API_KEY=

# Required: password for the dashboard login screen.
DASHBOARD_PASSWORD=

# Optional: Flask session signing key. Auto-generated if unset, but set a
# fixed value if you want sessions to survive a container restart.
FLASK_SECRET_KEY=

# Required: your n8n instance's webhook URLs. If n8n runs on your host
# machine and this container runs in Docker, host.docker.internal reaches
# it automatically on Docker Desktop (docker-compose.yml adds the Linux
# equivalent).
N8N_CHAT_WEBHOOK_URL=http://host.docker.internal:5678/webhook/your-webhook-id/chat
N8N_EVAL_RETRIEVE_WEBHOOK_URL=http://host.docker.internal:5678/webhook/eval-retrieve

# Optional: judge/embedding models (defaults shown)
# RAGAS_JUDGE_MODEL=gpt-4o-mini
# RAGAS_EMBEDDING_MODEL=text-embedding-3-small

# Optional: quick-mode random subset size range (defaults shown)
# QUICK_SUBSET_MIN=15
# QUICK_SUBSET_MAX=20

# Optional: score below this (0-1) on any metric gets flagged in the dashboard
# FLAG_THRESHOLD=0.7
