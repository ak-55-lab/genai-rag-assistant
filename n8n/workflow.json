    },
    {
      "parameters": {
        "content": "## \ud83d\udcac CHAT / RETRIEVAL PIPELINE\nAnswers user questions using the indexed knowledge base. Retrieves relevant chunks from Qdrant and generates an answer with the RAG Chat Agent.",
        "height": 240,
        "width": 256
      },
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -240,
        416
      ],
      "id": "7d6c1c49-941a-4694-92c5-312d91271350",
      "name": "Sticky Note1"
    },
    {
      "parameters": {
        "jsCode": "// For files that were already indexed before (is_reindex === true),\n// delete their existing chunks from Qdrant before the new ones get inserted,\n// so a changed file doesn't leave stale + fresh chunks both in the vector store.\nconst allItems = $input.all();\nconst qdrantBaseUrl = 'http://host.docker.internal:6333';\nconst qdrantCollection = 'gen_ai_academy';\n\nfor (const item of allItems) {\n    if (!item.json.is_reindex) continue;\n    const filePath = item.json.file_path;\n    const res = await fetch(`${qdrantBaseUrl}/collections/${qdrantCollection}/points/delete`, {\n          method: 'POST',\n          headers: { 'Content-Type': 'application/json' },\n          body: JSON.stringify({\n                  filter: {\n                            must: [\n                              { key: 'metadata.file_path', match: { value: filePath } }\n                                      ]\n                  }\n          })\n    });\n    if (!res.ok) {\n          const text = await res.text();\n          throw new Error(`Failed to delete stale Qdrant points for ${filePath}: ${res.status} ${text}`);\n    }\n}\n\nreturn allItems;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1216,
        0
      ],
      "id": "b9ac8e58-fceb-4a17-9c7a-11fe88c62106",
      "name": "Delete Stale Chunks if Re-indexing"
    },
    {
      "parameters": {
        "jsCode": "// The disk-read glob pattern can match the same physical file more than\n// once (confirmed: 198 items read for 33 real files = 6x duplicates).\n// Collapse to one item per unique file_path before anything downstream\n// (Filter, Docling, Qdrant) ever sees it.\nconst allItems = $input.all();\nconst seen = new Set();\nconst result = [];\n\nfor (const item of allItems) {\n    const bin = item.binary && item.binary.data;\n    if (!bin) continue;\n    const filePath = bin.directory + '/' + bin.fileName;\n    if (seen.has(filePath)) continue;\n    seen.add(filePath);\n    result.push(item);\n}\n\nreturn result;"
      },
