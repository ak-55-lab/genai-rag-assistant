    {
      "parameters": {
        "content": "## \ud83d\udce5 INDEXING PIPELINE\nRun manually to (re)index files from /data/gen-ai-academy into Qdrant. Checks the manifest first and only converts/embeds files that are new or changed.",
        "height": 224,
