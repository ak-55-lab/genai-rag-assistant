      "id": "e0554a3d-02dc-4899-88bb-31140f9b8b54",
      "name": "Upsert Indexed Files Manifest"
    },
    {
      "parameters": {
        "jsCode": "const manifestRows = $('Get Indexed Files Manifest').all();\nconst manifest = {};\nfor (const row of manifestRows) {\n  manifest[row.json.file_path] = row.json.file_size;\n}\n\nconst SKIP_FILES = new Set([]);\n\nconst allItems = $input.all();\nconst result = [];\n\nfor (const item of allItems) {\n  const bin = item.binary && item.binary.data;\n  if (!bin) continue;\n  const filePath = bin.directory + '/' + bin.fileName;\n  if (SKIP_FILES.has(filePath)) continue;\n  const fileSize = bin.bytes;\n  const previousSize = manifest[filePath];\n  if (previousSize === undefined || previousSize !== fileSize) {\n    item.json.file_path = filePath;\n    item.json.file_size = fileSize;\n    item.json.is_reindex = previousSize !== undefined;\n    result.push(item);\n  }\n}\n\nresult.sort((a, b) => a.json.file_size - b.json.file_size);\n\nreturn result;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        976,
        0
      ],
      "id": "f0c35fd8-f82f-44e5-88aa-106f00d3fbac",
      "name": "Filter New or Changed Files"
    },
    {
      "parameters": {
        "jsCode": "const allItems = $input.all();\nconst chunks = [];\nconst size = 512;\nconst overlap = 100;\n\nconst originalFiles = $('Filter New or Changed Files').all();\nconst fileInfoByBasename = {};\nfor (const orig of originalFiles) {\n  const fp = orig.json.file_path;\n  if (!fp) continue;\n  const base = fp.replace(/\\\\/g, '/').split('/').pop();\n  fileInfoByBasename[base] = { file_path: fp, file_size: orig.json.file_size };\n}\n\nfor (const item of allItems) {\n  const markdown = item.json.document?.md_content || '';\n  const rawSource = item.json.document?.filename || 'unknown';\n  const pathParts = rawSource.replace(/\\\\/g, '/').split('/');\n  const filename = pathParts[pathParts.length - 1];\n  const folder = pathParts.length > 1 ? pathParts[pathParts.length - 2] : 'root';\n  const info = fileInfoByBasename[filename] || {};\n  const filePath = info.file_path || rawSource;\n  const fileSize = info.file_size;\n  const words = markdown.split(/\\s+/).filter(w => w.length > 0);\n  let i = 0;\n  while (i < words.length) {\n    const text = words.slice(i, i + size).join(' ');\n    chunks.push({ json: { text, index: chunks.length, source: filename, file_path: filePath, file_size: fileSize, folder } });\n    i += size - overlap;\n  }\n}\n\nreturn chunks;"
      },
