    {
      "parameters": {
        "jsCode": "const allItems = $input.all();\nconst splitItems = $('Split Text into Chunks').all();\nconst seen = {};\nfor (let i = 0; i < allItems.length; i++) {\n    const src = (splitItems[i] && splitItems[i].json) || {};\n    const fp = src.file_path;\n    const fs = src.file_size;\n    if (!fp || fs === undefined) continue;\n    seen[fp] = fs;\n}\nconst result = Object.keys(seen).map(fp => ({ json: { file_path: fp, file_size: seen[fp] } }));\nreturn result;"
      },
